{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "notes",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Always invoke the Worker first so /api/* never falls through to static HTML.
    "run_worker_first": true
  },
  // Private store for your saved lists, synced across your devices (see Prefs in worker/index.js).
  "durable_objects": {
    "bindings": [{ "name": "PREFS", "class_name": "Prefs" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Prefs"] }],
  // Cloudflare's built-in AI for tender summaries (free daily allowance; see tenderSummary in worker/index.js).
  "ai": { "binding": "AI" },
  // Run the Worker in Mumbai: KPPP only answers connections from India, and the GitHub collectors reach
  // KPPP through this Worker (/kppp-relay in worker/index.js). Users are in India too.
  "placement": { "mode": "targeted", "region": "aws:ap-south-1" },
  "observability": {
    "enabled": true
  }
}
